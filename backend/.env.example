# Copy this file to .env and fill in the values.
# Never commit the real .env file.

PORT=4000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173

# Used by backend/docker-compose.yml.
# When the frontend is served by Nginx, set CORS_ORIGIN=http://localhost:8080.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
